# 공개 Hermes 게이트웨이 + kquant MCP 이미지 — 초안(2026-11-10 결정 D5, 미빌드·미검증).
# 기반: Hermes Agent 공식 이미지(Hermes 저장소의 Dockerfile로 빌드, 배포 때 버전·digest 고정).
# kquant는 Python 3.13 별도 venv(/opt/kquant-venv)에 설치하고, Hermes 설정의 mcp_servers.kquant-public.command가
# /opt/kquant-venv/bin/kquant-mcp를 하위 프로세스로 띄운다. docker CLI·소켓은 넣지 않는다.
ARG HERMES_IMAGE=hermes-agent:v0.22.2
FROM ${HERMES_IMAGE}

USER root
COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/kquant-venv \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /opt/kquant
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable && rm -rf /root/.cache/uv
# 이후 사용자·엔트리포인트는 Hermes 공식 이미지의 설정을 따른다(HERMES_UID/GID). 검증 때 비루트 실행을 확인한다.
