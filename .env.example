# kquant 환경변수 템플릿. `.env`로 복사해 값을 채운다(.env는 git 제외). 이 파일에는 값을 쓰지 않는다.

# 데이터 디렉터리(기본 ./dataset). 상대경로는 저장소 루트 기준
KQUANT_DATA_DIR=

# 리포트 HTML 출력 위치(기본 {KQUANT_DATA_DIR}/reports)와 공개 링크 앞부분(없으면 파일명만 응답)
KQUANT_REPORT_DIR=
KQUANT_REPORT_BASE_URL=

# Hermes 공개 프로필 API 키(= 그 프로필 .env의 API_SERVER_KEY)와 주소(check-hermes, 기본 http://127.0.0.1:8643)
HERMES_API_KEY=
KQUANT_HERMES_URL=
